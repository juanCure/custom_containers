# ================================================
# Custom ModSecurity Configuration (No CRS)
# ================================================

SecRuleEngine On

SecRequestBodyAccess On
SecResponseBodyAccess Off
SecResponseBodyMimeType text/plain text/html text/xml
SecResponseBodyLimit 524288
SecResponseBodyLimitAction ProcessPartial

# Logs
SecAuditEngine RelevantOnly
SecAuditLogParts ABIJDEFHZ
SecAuditLogType Serial
#SecAuditLog /var/log/modsec_audit.log
#SecDebugLog /var/log/modsec_debug.log
#SecDebugLogLevel 0

SecUnicodeMapFile /etc/modsecurity.d/unicode.mapping 20127

# No cargar CRS
# Include /etc/modsecurity.d/owasp-crs/crs-setup.conf
# Include /etc/modsecurity.d/owasp-crs/rules/*.conf

# Incluir tus reglas personalizadas
Include /etc/modsecurity.d/custom_rules/ojs_rules.conf

# Incluir exclusiones para OJS
Include /etc/modsecurity.d/custom_rules/ojs_exclusions.conf

